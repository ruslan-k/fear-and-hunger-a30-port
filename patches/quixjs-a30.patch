+// A30: physical buttons are keyboard events on /dev/input/event3
+// (gpio-keys-polled); the virtual SDL pad does not carry them. Feed them as
+// quixjs key events, the same route the working Undertale port uses.
+static void a30_read_keys(Backend* backend) {
+  if (a30KeyFd < 0) return;
+  struct input_event ev;
+  while (read(a30KeyFd, &ev, sizeof ev) == (ssize_t)sizeof ev) {
+    if (ev.type != EV_KEY) continue;
+    const char *code = NULL;
+    switch (ev.code) {
+      case 103: code = "ArrowUp";    break;
+      case 108: code = "ArrowDown";  break;
+      case 105: code = "ArrowLeft";  break;
+      case 106: code = "ArrowRight"; break;
+      case 57:  code = "KeyZ";       break;  // A -> confirm
+      case 29:  code = "KeyX";       break;  // B -> cancel
+      case 42:  code = "KeyX";       break;  // X -> cancel
+      case 56:  code = "KeyC";       break;  // Y -> menu
+      case 28:  code = "Enter";      break;  // Start
+      case 97:  code = "Escape";     break;  // Select
+      default: break;
+    }
+    if (code) {
+      InputEvent in;
+      if (keymap_make_event(&in, ev.value ? INPUT_KEY_DOWN : INPUT_KEY_UP, code, 0, 0) == 0)
+        backend_push_input(backend, &in);
+    }
+    if (ev.code == 1) {  // physical Menu/Esc: long press quits
+      if (ev.value) a30MenuDownAt = SDL_GetTicks();
+      else {
+        if (a30MenuDownAt && SDL_GetTicks() - a30MenuDownAt >= 1000) {
+          SDLPlatformData* d = (SDLPlatformData*)backend->platform_data;
+          d->should_close = 1;
+        }
+        a30MenuDownAt = 0;
+      }
+    }
+  }
+}
